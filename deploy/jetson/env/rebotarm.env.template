# reBotArm server environment — Jetson user-space deployment (Phase 7B).
# This file is installed as $BASE/shared/env/rebotarm.env with mode 600.
# Target Phase 7I deployment: motorbridge on can1, loopback-only HTTP.
# The enable gate is intentionally explicit and is still reachable only via
# the user-confirmed POST /api/robot/enable or /api/robot/disable endpoints.

# Adapter: simulation (smoke) | motorbridge (real bus, scan + telemetry).
REBOT_ADAPTER=motorbridge

# SocketCAN channel for this robot. PCAN-USB 的接口名以
# `sudo $BASE/bin/rebotarm-can-init.sh` 的自动检测输出为准(常见 can0/can1/can2,
# 取决于板载 CAN 占用,不要写死为 can1)。
REBOT_CAN_CHANNEL=can1

# robstride host / feedback ID (one byte).
REBOT_HOST_ID=0xFD

# Per-ping timeout (ms); clamped to 10..2000 by the server.
REBOT_PING_TIMEOUT_MS=500

# Telemetry frame rate (Hz); clamped to 1..50 by the server.
REBOT_TELEMETRY_HZ=10

# Active-report configuration is performed once after a full ID 1..7 scan.
REBOT_ALLOW_ACTIVE_REPORT_WRITE=1

# Manual enable/disable gate. Default in code remains 0; target deployment
# enables it only after the environment backup is verified.
REBOT_ALLOW_ENABLE_WRITE=1

# Verified persistent position/velocity-loop gain gate. This is NOT MIT-frame
# kp/kd and is not a zero-torque shortcut.
REBOT_ALLOW_PARAMETER_WRITE=1

# Mechanical-zero flow verified from rebot-rs-record/rs_tools.py:
# per motor disable -> read 0x7019 -> set_zero_position -> store_parameters.
# Requires the arm to be physically placed at the desired zero before click.
REBOT_ALLOW_SET_ZERO_WRITE=1

# Backend-owned zero-torque mode gate. User UI confirmation is still required;
# the task/deployment/test suite never calls its start/stop endpoints.
REBOT_ALLOW_ZERO_TORQUE_WRITE=1
REBOT_ZERO_TORQUE_HZ=50

# Real POS_VEL aging loop. Clicking Start Aging starts both motion and the
# existing 10 Hz telemetry recorder; service startup itself never starts it.
REBOT_ALLOW_AGING_WRITE=1

# Loopback bind only. Never expose the service unauthenticated.
REBOT_HOST=127.0.0.1
REBOT_PORT=8000

# Structured JSON logs.
REBOT_LOG_JSON=1
REBOT_LOG_LEVEL=INFO

# Aging telemetry is written only while the operator runs an aging session.
# The start script fixes REBOT_AGING_LOG_ROOT to $BASE/log; it is not selected
# in the UI and must not be overridden here.
# Minimum free bytes checked before a session directory is created.
# REBOT_AGING_LOG_MIN_FREE_BYTES=104857600
# Generated telemetry CSV segment period in seconds (1..86400).
# REBOT_AGING_LOG_SEGMENT_SECONDS=300

# NOTE: REBOT_WEB_DIST_DIR is intentionally NOT set here — the start script
# always points it at the CURRENT release's pre-built web UI:
#   $BASE/current/web/dist
