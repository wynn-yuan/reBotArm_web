# reBotArm server configuration (copy to .env and adjust).
# Every value below is the built-in default unless noted otherwise.

# --- Adapter ---------------------------------------------------------------
# simulation   : development default, never touches CAN hardware and never
#                imports the motorbridge SDK.
# motorbridge  : real hardware, read-only scan only. Requires EXACTLY
#                motorbridge 0.5.1 (pinned in pyproject.toml); startup fails
#                closed on any other version or if the native ABI cannot
#                load. There is NO silent fallback to simulation.
REBOT_ADAPTER=simulation

# --- CAN ---------------------------------------------------------------------
# SocketCAN channel. Strictly validated against ^can[0-9]+$ (e.g. can0).
REBOT_CAN_CHANNEL=can0

# robstride host / feedback ID (one byte). Default 0xFD (253).
REBOT_HOST_ID=0xFD

# Per-ping timeout in milliseconds, passed to the SDK's
# robstride_ping_host_id(). 500 is the SDK/vendor default. Values are clamped
# to 10..2000 so a full 7-ID scan can never block the API for long.
# Only used by the motorbridge adapter.
REBOT_PING_TIMEOUT_MS=500

# --- Telemetry (/ws/robot/telemetry) ----------------------------------------
# Frame rate (frames/second) of the telemetry stream. Clamped to 1..50.
REBOT_TELEMETRY_HZ=10

# Authorization for the ONE permitted motor write (default OFF, fail closed).
# Real RobStride telemetry in motorbridge mode requires toggling the motor's
# active status reporting via robstride_set_active_report(). This is the
# only write the server is ever allowed to make, and only this narrowly:
#   - True  once per motor (IDs 1..7) when the FIRST telemetry client
#     subscribes — and only after a fully successful scan (all IDs found),
#     with REBOT_ADAPTER=motorbridge and motorbridge exactly 0.5.1;
#   - False on cleanup: last client disconnect, robot disconnect, service
#     stop, or rollback of a partially failed enable.
# It does NOT enable motors and cannot command motion (its only parameter is
# a boolean — see README §5.2 for the 0.5.1 source evidence). With this
# flag off (default) no motor is ever written to and motorbridge telemetry
# connections are rejected with a "telemetry_not_allowed" error frame.
REBOT_ALLOW_ACTIVE_REPORT_WRITE=0

# --- Simulation adapter only --------------------------------------------------
# Comma-separated motor IDs that "respond" during a simulated scan.
# Default: all expected IDs 1..7 (=> status "connected").
# Use e.g. "1,2,3,4,5,6" to exercise the "partial" path.
REBOT_SIM_FOUND_IDS=1,2,3,4,5,6,7

# Artificial scan duration in seconds (0 = instant). Useful to exercise the
# "scanning" state and the 409 concurrent-scan path from a shell.
REBOT_SIM_SCAN_DELAY_S=0

# Set to 1 to simulate a hard adapter failure (=> status "error").
REBOT_SIM_FATAL_ERROR=0

# --- HTTP / CORS ---------------------------------------------------------------
# Comma-separated allowed CORS origins. When EMPTY (default), only
# http(s)://localhost:<port> and http(s)://127.0.0.1:<port> are allowed.
# Use "*" to allow any origin (development only, never on a robot).
REBOT_CORS_ORIGINS=

# Bind address / port. Keep 127.0.0.1 unless you understand the consequences;
# a robot backend must never be exposed unauthenticated on a public interface.
REBOT_HOST=127.0.0.1
REBOT_PORT=8000

# --- Optional same-origin static hosting ----------------------------------------
# Directory holding the PRE-BUILT web UI (apps/web/dist). When set, the same
# server process serves the SPA (with client-side-routing fallback) in
# addition to /api and /ws — no nginx/Node needed on the robot host.
# EMPTY (default) = static hosting disabled. Fail closed: the server refuses
# to start if the value is set but the directory does not exist, is not a
# directory, or has no index.html. /api and /ws always keep priority; path
# traversal outside the directory and hidden files are never served.
REBOT_WEB_DIST_DIR=

# --- Logging --------------------------------------------------------------------
# Structured JSON lines on stdout (1) or plain text (0).
REBOT_LOG_JSON=1
# DEBUG | INFO | WARNING | ERROR | CRITICAL
REBOT_LOG_LEVEL=INFO

# --- Backend action library (Trajectory) -----------------------------------------
# Directory holding the Trajectory action library: the operating page records
# processed actions here and the aging page reads them back for execution.
# Deployment pins this to $BASE/Trajectory (side-by-side with the aging log).
# EMPTY (default) = the action library is disabled. Must be an absolute path.
REBOT_TRAJECTORY_DIR=

# --- Aging motion (MIT mode) -------------------------------------------------------
# Per-joint MIT position-servo gains (J1..J6 + gripper, exactly 7 values).
# Defaults match the reference hardware config (reBotArm_control/rebotarm_rs.yaml).
# REBOT_MIT_KP=50,150,150,50,50,50,50
# REBOT_MIT_KD=3,10,10,5,4,4,4
